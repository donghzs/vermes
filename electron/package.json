{
  "name": "vermes-electron",
  "version": "2.3.2",
  "description": "Vermes - AI Agent Desktop (Electron Shell + Python Backend)",
  "main": "main.js",
  "author": "Vbit (vbit.top)",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "prebuild": "bash ../scripts/prebuild-check.sh --fix && bash ../scripts/sync-version.sh",
    "pack": "npm run prebuild && electron-builder --dir",
    "dist:mac": "npm run prebuild && cd ../ && .venv/bin/pyinstaller vermes-backend.spec --noconfirm && cd electron && electron-builder --mac",
    "dist:win": "npm run prebuild && cd ../ && python -m PyInstaller vermes-backend.spec --noconfirm && cd electron && electron-builder --win",
    "dist:all": "npm run dist:mac && npm run dist:win"
  },
  "build": {
    "appId": "com.vermes.desktop",
    "productName": "Vermes",
    "icon": "assets/icon.png",
    "directories": {
      "output": "../dist-electron"
    },
    "files": [
      "main.js",
      "preload.js",
      "splash.html",
      "package.json",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": "../dist/vermes-backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../hermes_cli/web_dist",
        "to": "app/hermes_cli/web_dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "version.txt",
        "to": "version.txt"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/vermes.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "assets/vermes.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": false,
      "installerIcon": "assets/vermes.ico",
      "uninstallerIcon": "assets/vermes.ico",
      "language": "2052",
      "include": "installer.nsh"
    }
  },
  "devDependencies": {
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.3"
  }
}
