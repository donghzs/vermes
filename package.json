{
  "name": "vermes-agent",
  "description": "An AI agent with advanced tool-calling capabilities, featuring a flexible toolsets system for organizing and managing tools.",
  "private": true,
  "scripts": {
    "postinstall": "echo '\u2705 Browser tools ready. Run: python run_agent.py --help'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/donghzs/vermes.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/donghzs/vermes/issues"
  },
  "homepage": "https://github.com/donghzs/vermes#readme",
  "dependencies": {
    "agent-browser": "^0.26.0"
  },
  "overrides": {
    "lodash": "4.18.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "version": "2.3.7",
  "build": {
    "appId": "top.vbit.vermes",
    "productName": "Vermes",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/main.js",
      "electron/preload.js",
      "electron/assets/**/*",
      "splash.html",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "icon": "electron/assets/vermes.icns",
      "hardenedRuntime": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": "x64"
        }
      ],
      "icon": "packaging/vermes.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "extraResources": [
      {
        "from": "dist/vermes-backend",
        "to": "backend"
      }
    ]
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "main": "electron/main.js"
}